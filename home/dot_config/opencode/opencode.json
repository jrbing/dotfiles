{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail"
  ],
  "provider": {
    "bing": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bing Industries Omniroute",
      "options": {
        "baseURL": "https://omniroute.bingindustries.com/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "best-free": {
          "name": "Bing Best Free"
        },
        "best": {
          "name": "Bing Best"
        }
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8989/v1",
        "apiKey": "sk-omlx-Bkzzh3IwxjqYNaaI10b6bIxw"
      },
      "models": {
        "Qwen3.8-27B-4bit": {
          "name": "Qwen3.8-27B-4bit",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "kubernetes": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@latest"
      ]
    }
  },
  "model": "omlx/Qwen3.8-27B-4bit"
}
