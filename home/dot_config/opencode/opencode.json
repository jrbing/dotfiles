{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX",
      "options": {
        "baseURL": "http://127.0.0.1:8989/v1",
        "apiKey": ""
      },
      "models": {
        "Qwen3.8-27B-4bit": {
          "name": "Qwen3.8-27B-4bit",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "kubernetes": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "kubernetes-mcp-server@latest"
      ]
    },
    "paperclip": {
      "type": "remote",
      "url": "https://paperclip.bingindustries.com/mcp/paperclip"
    }
  }
}
