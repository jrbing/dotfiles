[user]
	name = JR Bing
	email = jrbing@users.noreply.github.com
	editor = vim
	signingkey = ~/.ssh/id_ed25519_jrbing.pub

[color]
	ui = auto

[url "git@github.com:"]
	pushinsteadof = https://github.com/

[commit]
	gpgsign = true

[gpg]
	format = ssh

[fetch]
	prune = true

[github]
	user = jrbing

[core]
	quotepath = false
	pager = delta
	editor = vim
	excludesfile = ~/.config/git/ignore
	whitespace = warn

[init]
	defaultBranch = main

[alias]
	shorten = "!sh -c 'curl -i http://git.io -F url=$1' -"
	lg = log -10 --reverse
	pruneremote = remote prune origin
	tree = !"git log --graph --oneline --decorate --color --all | ${PAGER}"
	reset-authors = commit --amend --reset-author -CHEAD
	rmbranch = "!f(){ git branch -d ${1} && git push origin --delete ${1}; };f"
	snapshot = !git stash save "snapshot: $(date)" && git stash apply "stash@{0}"

[color]
	ui = auto
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[format]
	pretty = format:%C(blue)%ad%Creset %C(yellow)%h%C(green)%d%Creset %C(blue)%s %C(magenta) [%an]%Creset

[merge]
	summary = true
	verbosity = 1
	tool = mvimdiff
	conflictStyle = zdiff3

[mergetool]
	prompt = false

[mergetool "mvimdiff"]
	cmd="mvim -c 'Gdiff' $MERGED"     # use fugitive.vim for 3-way merge
	keepbackup=false

[apply]
	whitespace = nowarn

[branch]
	autosetupmerge = true
	autosetuprebase = always

[web]
	browser = open

[push]
	default = matching

[pull]
	rebase = true

[rebase]
	autoStash = true

{{ if eq .chezmoi.os "macos" -}}
[credential]
	helper = osxkeychain
{{ end -}}
{{ if eq .chezmoi.os "linux" -}}
[credential]
	credentialStore = cache
{{ end -}}

[filter "media"]
	required = true
	clean = git media clean %f
	smudge = git media smudge %f

[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[diff "sopsdiffer"]
	textconv = sops -d

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
