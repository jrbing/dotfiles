# Config generated by Ghostty Config
# https://ghostty.zerebos.com

font-family = Inconsolata-dz for Powerline
font-size = 12

# --- Match iTerm2 font rendering (profile "macbook") ---
# Tuned by screenshotting the same text in both terminals and comparing
# glyph coverage. Display is a 2560x1440 monitor at 1x (NOT Retina), which is
# why iTerm2's "Thin Strokes = Retina only" never engages and its text is
# heavier than Ghostty's default rendering.

# Cell height: iTerm2 = 17px @ 12pt, Ghostty = 16px (it rounds the font's
# hhea ascent/descent/lineGap down where iTerm2 rounds up). +1px = exact match.
adjust-cell-height = 1

# Stroke weight. Measured glyph coverage vs iTerm2:
#   thicken off -28%   |  strength 128 -11%  |  strength 220 -1.4%
#   strength 60 -16%   |  strength 180  -6%  |  strength 255 +3.5%  <- closest
# font-thicken also turns on macOS font smoothing, which is what makes the
# edges look as smooth as iTerm2 (edge color fringing 25.1 vs iTerm2's 25.7).
font-thicken = true

# alpha-blending intentionally left at the macOS default (native).
# linear-corrected was measured as a worse match to iTerm2's glyph edges.

# iTerm2: Use Bold Font = off, Use Bright Bold = off, Use Italic Font = on.
# This makes bold text render in the regular face, same as iTerm2 does.
font-synthetic-style = italic,bold-italic
macos-icon = holographic
macos-icon-ghost-color = #C7DB31
term = xterm-256color
theme = Gruvbox Dark
