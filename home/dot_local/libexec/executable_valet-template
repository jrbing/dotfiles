#!/usr/bin/env ruby
# Usage: valet template <type> [name]
# Summary: Create a file from a bundled ERB template
# Help: Renders one of the templates in ~/.local/share/valet/templates into the
# current directory. Run with no <type> to list the available types.

require 'erb'
require 'fileutils'

TEMPLATES = File.expand_path('~/.local/share/valet/templates')

# ponytail: replaces the Thor-based generator; ERB and FileUtils are stdlib, so
# no gem is needed. [template, output ('%s' = name), chmod mode, name ivar]
RECIPES = {
  'sqlplus'       => ['sqlplus_script.erb',     '%s.sql',             nil,   :script_name],
  'datamover'     => ['datamover_script.erb',   '%s.dms',             nil,   :script_name],
  'bash'          => ['bash_script.erb',        '%s.sh',              0o755, :script_name],
  'envrc'         => ['envrc.erb',              '.envrc',             nil,   nil],
  'mise'          => ['mise.erb',               '.mise.toml',         nil,   nil],
  'thorfile'      => ['thor_script.erb',        'Thorfile',           0o755, nil],
  'batch'         => ['batch_script.erb',       '%s.bat',             nil,   :script_name],
  'powershell'    => ['powershell.erb',         '%s.ps1',             nil,   :script_name],
  'make'          => ['makefile.erb',           'Makefile',           nil,   nil],
  'task'          => ['taskfile.erb',           'Taskfile.yml',       nil,   nil],
  'editorconfig'  => ['editorconfig.erb',       '.editorconfig',      nil,   nil],
  'readme'        => ['readme.erb',             'README.md',          nil,   :project_name],
  'python'        => ['python_script.erb',      '%s.py',              0o755, :script_name],
  'dockerfile'    => ['dockerfile.erb',         'Dockerfile',         nil,   nil],
  'dockercompose' => ['dockercompose.erb',      'docker-compose.yml', nil,   nil],
  'vrc'           => ['vrc.erb',                '%s.rest',            nil,   :script_name],
  'modd'          => ['modd_configuration.erb', 'modd.conf',          nil,   nil],
  'markdown'      => ['markdown.erb',           '%s.md',              nil,   :file_name],
  'mutagen'       => ['mutagen.erb',            'mutagen.yml',        nil,   nil],
}.freeze

DOS = %w[datamover batch powershell].freeze

# Holds the template's @ivars so ERB can render against them.
class Vars
  def initialize(values)
    values.each { |key, value| instance_variable_set("@#{key}", value) }
  end
end

def prompt(message)
  $stdout.print(message)
  $stdout.flush
  $stdin.gets&.strip
end

def render(template, output, values)
  context = Vars.new(values)
  source = File.read(File.join(TEMPLATES, template))
  File.write(output, ERB.new(source).result(context.instance_eval { binding }))
  output
end

def to_dos(*paths)
  return if paths.empty?
  return unless system('sh', '-c', 'command -v unix2dos >/dev/null 2>&1')

  system('unix2dos', *paths)
end

def make_datafix(name)
  name = prompt('Name: ') if name.nil? || name.empty?
  abort 'valet template: a name is required' if name.nil? || name.empty?

  records = prompt('Records to be affected: ').to_s.upcase.split.uniq
  values = { datafix_name: name, date: Time.now.localtime.strftime('%m/%d/%Y') }
  directory = File.join(Dir.pwd, name)
  FileUtils.mkdir_p(directory)

  render('datafix_script.erb', File.join(directory, "#{name}.sql"), values)
  records.each do |record|
    render('sqlcl_backup_insert.erb', File.join(directory, "#{record}_backup_script.sql"),
           values.merge(record: record))
  end
  to_dos(*Dir.glob(File.join(directory, '*')))
end

type = ARGV.shift

if type.nil? || %w[-h --help help].include?(type)
  puts 'Usage: valet template <type> [name]'
  puts
  puts "Types: #{RECIPES.keys.sort.join(', ')}, datafix"
  exit 0
end

if type == 'datafix'
  make_datafix(ARGV.shift)
  exit 0
end

recipe = RECIPES[type] or abort "valet template: unknown type `#{type}'"
template, output, mode, attr = recipe

name = ARGV.shift
name = prompt('Name: ') if name.nil? && attr
abort 'valet template: a name is required' if attr && (name.nil? || name.empty?)

values = { date: Time.now.localtime.strftime('%m/%d/%Y') }
values[attr] = name if attr
output = format(output, name) if output.include?('%s')

render(template, output, values)
File.chmod(mode, output) if mode
to_dos(output) if DOS.include?(type)
