#!/usr/bin/env bash
# valet: run a personal ~/.local/libexec/valet-<command> script.
# ponytail: replaces the vendored 856-line Python "sub" framework; only
# dispatch and command listing were used.
set -euo pipefail

libexec="${HOME}/.local/libexec"

if [ "$#" -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
	printf 'Usage: valet <command> [args...]\n\nCommands:\n'
	for script in "${libexec}"/valet-*; do
		[ -e "${script}" ] || continue
		printf '  %s\n' "${script##*/valet-}"
	done | sort
	exit 0
fi

command="$1"
shift
script="${libexec}/valet-${command}"
if [ ! -x "${script}" ]; then
	printf 'valet: no such command `%s'\''\n' "${command}" >&2
	exit 1
fi

exec "${script}" "$@"
